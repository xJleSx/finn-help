#!/usr/bin/env python3
"""FinanceMarker skill — thin entry-point wrapper.

Forwards argv to fmc.py in the same directory.
"""
from __future__ import annotations

import runpy
import sys
from pathlib import Path


def main() -> int:
    here = Path(__file__).resolve().parent
    script = here / "fmc.py"
    sys.argv[0] = str(script)
    runpy.run_path(str(script), run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(main())
