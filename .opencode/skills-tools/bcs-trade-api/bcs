#!/usr/bin/env python3
"""BCS Trade API skill — thin entry-point wrapper.

Forwards argv to bcs.py in the same directory. This file is executable
on both POSIX and Windows (via the .venv launcher).
"""
from __future__ import annotations

import os
import runpy
import sys
from pathlib import Path


def main() -> int:
    here = Path(__file__).resolve().parent
    script = here / "bcs.py"
    sys.argv[0] = str(script)
    runpy.run_path(str(script), run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(main())
