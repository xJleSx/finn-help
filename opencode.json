{
  "$schema": "https://opencode.ai/config.json",

  "model": "zen/deepseek-v4-flash-free",
  "small_model": "zen/deepseek-v4-flash-free",

  "references": {
    "src": {
      "path": "src",
      "description": "Python backend: FastAPI, SQLAlchemy, analysis, ML, trading, signals"
    },
    "web": {
      "path": "web",
      "description": "Next.js frontend: React components, charts, Tailwind"
    },
    "tests": {
      "path": "tests",
      "description": "pytest tests: fixtures, conftest, test patterns"
    },
    "docs": {
      "path": ".",
      "description": "README, pyproject.toml, env, Docker config"
    }
  },

  "instructions": [".opencode/rules/output-rules.md"],

  "compaction": { "auto": true, "prune": true, "tail_turns": 25 },

  "plugin": [
    "@alvarovfon/opencode-agent-monitor",
    "rtk-for-opencode"
  ],

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "description": "Browser automation for frontend E2E testing of the Next.js dashboard"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "description": "GitHub integration: PRs, issues, commits, CI/CD workflows",
      "env": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
      "enabled": false,
      "description": "PostgreSQL database introspection and queries"
    }
  }
}
