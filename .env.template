# ── Database ──────────────────────────────────────────────
# NOTE: Using a relative path like sqlite:///data/finn.db resolves
# relative to the CWD at runtime, NOT the project root.
# Use an absolute path or %(here)s if supported by your runner.
DATABASE_URL=sqlite:///data/finn.db

# ── Security ──────────────────────────────────────────────
# Generate with: python -m src.cli security generate-key
# ENCRYPTION_KEY=

# Generate with: python -m src.cli security generate-jwt-secret
# JWT_SECRET=

# Generate with: python -m src.cli security generate-jwt-refresh-secret
# JWT_REFRESH_SECRET=

# ── LLM Providers ─────────────────────────────────────────
# At least one of GROQ or Ollama must be configured.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── Broker APIs ───────────────────────────────────────────
# Store tokens via: python -m src.cli security credential-set <broker> <token>
# TINKOFF_TOKEN=
# TINKOFF_SANDBOX=true

# BCS_REFRESH_TOKEN=
# BCS_SANDBOX=true

# ── Redis / Celery ────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Optional APIs ─────────────────────────────────────────
# FM_API_TOKEN=
# WOLFRAM_APP_ID=

# ── App Config ────────────────────────────────────────────
# LOG_LEVEL=INFO
# API_HOST=0.0.0.0
# API_PORT=8000
